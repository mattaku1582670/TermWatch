{
  "name": "termwatch",
  "version": "1.0.0",
  "description": "Windows PC の VS Code ターミナルで動く CLI エージェントを、スマートフォンから安全に監視・操作するツール",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "termwatch": "./dist/app/cli/main.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build": "npm run clean && npm run build:server && npm run build:web",
    "package:win": "node scripts/package-win.mjs",
    "install:local": "node scripts/install-local.mjs",
    "release:local": "npm run build && npm run package:win && npm run install:local",
    "start": "node dist/app/cli/main.js"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
